# CodeAtlas backend configuration. Copy to .env and adjust. Every key is optional.
# All variables use the CODEATLAS_ prefix and are read only in backend/app/core/config.py.

# "development" or "production"
CODEATLAS_ENVIRONMENT=development

# --- Upload / archive safety limits ---
CODEATLAS_MAX_UPLOAD_BYTES=104857600          # 100 MB compressed upload
CODEATLAS_MAX_UNCOMPRESSED_BYTES=1073741824   # 1 GB total extracted bytes
CODEATLAS_MAX_FILE_BYTES=52428800             # 50 MB per extracted file (larger files are skipped)
CODEATLAS_MAX_FILES=100000                    # analyzed files (excluded paths do not count); benchmarked
CODEATLAS_MAX_DIRECTORIES=50000
CODEATLAS_MAX_ARCHIVE_ENTRIES=200000          # hard cap on central-directory entries, including excluded ones
CODEATLAS_MAX_DEPTH=64
CODEATLAS_MAX_PATH_LENGTH=1024
CODEATLAS_MAX_COMPRESSION_RATIO=100           # whole-archive ratio, applied once output exceeds 10 MB
CODEATLAS_MAX_ANALYSIS_SECONDS=300            # 100k files took 18 s on an Apple M4; headroom for slower hosts
CODEATLAS_MAX_CONCURRENT_ANALYSES=2           # analyses running at once (worker threads)
CODEATLAS_MAX_QUEUED_JOBS=4                   # further uploads waiting; beyond this → 503 server_busy
CODEATLAS_JOB_TTL_SECONDS=600                 # how long finished job records stay queryable

# --- Result retention (in memory only) ---
CODEATLAS_PROJECT_TTL_SECONDS=1800
CODEATLAS_MAX_STORED_PROJECTS=10
CODEATLAS_MAX_STORED_NODES=500000             # ~0.67 KB per node → ~335 MB across all stored results
CODEATLAS_MAX_TREE_RESPONSE_NODES=25000       # larger /tree requests get 422 tree_too_large

# Directory for temporary extraction (defaults to the OS temp dir)
# CODEATLAS_TEMP_DIR=/var/tmp/codeatlas

# --- Serving ---
# Serve frontend/public from the API process (single-origin local setup)
CODEATLAS_SERVE_FRONTEND=true
# Comma-separated origins allowed to call the API when the frontend is deployed separately
CODEATLAS_CORS_ORIGINS=
