{
  "name": "codeatlas-frontend",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "CodeAtlas dashboard: vanilla JavaScript ES modules + Tailwind CSS. No framework, no bundler.",
  "scripts": {
    "build": "npm run build:css && npm run vendor",
    "build:css": "tailwindcss -i ./src/input.css -o ./public/assets/app.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/assets/app.css --watch",
    "vendor": "node -e \"require('fs').mkdirSync('public/vendor',{recursive:true});require('fs').copyFileSync('node_modules/cytoscape/dist/cytoscape.esm.min.mjs','public/vendor/cytoscape.esm.min.mjs')\"",
    "test": "node --test \"tests/**/*.test.js\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cytoscape": "3.34.4"
  },
  "license": "AGPL-3.0-only"
}
